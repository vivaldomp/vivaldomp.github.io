---
import Section from './Section.astro';

const projects = [
  {
    name: 'opendesign-dockerized',
    title: 'Open Design, Dockerized',
    description:
      'Containerized version of Open Design with GitHub Copilot CLI integration — a sandboxed, reproducible workspace for AI-augmented design-to-code workflows.',
    language: 'Dockerfile',
    languageColor: '#384d54',
    url: 'https://github.com/vivaldomp/opendesign-dockerized',
    tags: ['Docker', 'AI Agents', 'Copilot CLI'],
    updated: 'May 2026',
  },
  {
    name: 'zBANK-modernization',
    title: 'zBANK — COBOL → TypeScript',
    description:
      'A coding-agent-driven experiment modernizing legacy COBOL banking logic into a modern TypeScript stack, demonstrating spec-driven mainframe modernization.',
    language: 'TypeScript',
    languageColor: '#3178c6',
    url: 'https://github.com/vivaldomp/zBANK-modernization',
    tags: ['COBOL', 'TypeScript', 'Modernization', 'Coding Agents'],
    updated: 'Apr 2026',
  },
  {
    name: 'kexpr',
    title: 'Kexpr — Conditional Expression Engine',
    description:
      'Lightweight, secure conditional expression engine for Node.js and browsers. Designed for embedding rule logic in workflow engines and feature-flag platforms.',
    language: 'TypeScript',
    languageColor: '#3178c6',
    url: 'https://github.com/vivaldomp/kexpr',
    tags: ['Rule Engine', 'TypeScript', 'DSL'],
    updated: 'May 2025',
  },
  {
    name: 'featureflags-demo',
    title: 'Feature Flags Microservice',
    description:
      'Distributed feature-flag platform built with a Go microservice, a React.js demo app served by Nginx, and Minio-backed storage — illustrating progressive delivery patterns.',
    language: 'Go',
    languageColor: '#00ADD8',
    url: 'https://github.com/vivaldomp/featureflags-demo',
    tags: ['Go', 'React', 'Microservices', 'Feature Flags'],
    updated: 'Oct 2023',
  },
  {
    name: 'fourkeys-data-generator',
    title: 'Four Keys Data Generator',
    description:
      'Synthetic event generator for the DORA Four Keys metrics pipeline — accelerating dashboard development and DevOps performance experimentation.',
    language: 'Go',
    languageColor: '#00ADD8',
    url: 'https://github.com/vivaldomp/fourkeys-data-generator',
    tags: ['Go', 'DORA', 'DevOps Metrics'],
    updated: 'Dec 2022',
  },
];
---

<Section
  id="projects"
  eyebrow="Featured work"
  title="Latest from the lab"
  lead="Recent open-source projects exploring AI-augmented engineering, modernization, and platform tooling."
>
  <div class="container">
    <ul class="grid">
      {projects.map((p) => (
        <li class="card">
          <a href={p.url} target="_blank" rel="noopener noreferrer" class="link">
            <header>
              <div class="title-row">
                <svg class="repo-icon" width="16" height="16" viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                  <path d="M2 2.5A2.5 2.5 0 0 1 4.5 0h8.75a.75.75 0 0 1 .75.75v12.5a.75.75 0 0 1-.75.75h-2.5a.75.75 0 0 1 0-1.5h1.75v-2h-8a1 1 0 0 0-.714 1.7.75.75 0 1 1-1.072 1.05A2.495 2.495 0 0 1 2 11.5Zm10.5-1h-8a1 1 0 0 0-1 1v6.708A2.486 2.486 0 0 1 4.5 9h8ZM5 12.25a.25.25 0 0 1 .25-.25h3.5a.25.25 0 0 1 .25.25v3.25a.25.25 0 0 1-.4.2l-1.45-1.087a.249.249 0 0 0-.3 0L5.4 15.7a.25.25 0 0 1-.4-.2Z"/>
                </svg>
                <span class="repo-name">{p.name}</span>
                <svg class="external" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                  <path d="M7 17 17 7M7 7h10v10"/>
                </svg>
              </div>
              <h3>{p.title}</h3>
            </header>

            <p class="desc">{p.description}</p>

            <div class="tags">
              {p.tags.map((t) => (
                <span class="tag">{t}</span>
              ))}
            </div>

            <footer>
              <span class="lang">
                <span class="lang-dot" style={`background:${p.languageColor}`}></span>
                {p.language}
              </span>
              <span class="updated">Updated {p.updated}</span>
            </footer>
          </a>
        </li>
      ))}
      <li class="card more">
        <a href="https://github.com/vivaldomp" target="_blank" rel="noopener noreferrer" class="link">
          <div class="more-inner">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M5 12h14M12 5l7 7-7 7"/>
            </svg>
            <h3>More on GitHub</h3>
            <p>13+ public repos exploring platforms, agents, and DevOps.</p>
          </div>
        </a>
      </li>
    </ul>
  </div>
</Section>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(310px, 1fr));
    gap: 18px;
  }
  .card {
    background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    overflow: hidden;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    box-shadow: var(--shadow-lg);
  }
  .link {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 24px;
    color: var(--text);
    gap: 14px;
  }
  .link:hover { color: var(--text); }
  .title-row {
    display: flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 4px;
  }
  .repo-icon { color: var(--text-dim); }
  .repo-name {
    color: var(--accent);
  }
  .external {
    margin-left: auto;
    color: var(--text-dim);
    transition: transform 0.2s ease, color 0.2s ease;
  }
  .card:hover .external {
    transform: translate(2px, -2px);
    color: var(--accent);
  }
  h3 {
    font-size: 18px;
    font-weight: 600;
    margin: 0;
  }
  .desc {
    color: var(--text-muted);
    font-size: 14.5px;
    line-height: 1.65;
    flex: 1;
  }
  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }
  .tag {
    padding: 4px 10px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.22);
    border-radius: 999px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--accent);
  }
  footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    padding-top: 14px;
    border-top: 1px dashed var(--border);
    font-family: var(--font-mono);
    font-size: 12px;
    color: var(--text-dim);
  }
  .lang {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .lang-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .card.more {
    background: rgba(34, 211, 238, 0.04);
    border-style: dashed;
  }
  .card.more .link {
    align-items: center;
    justify-content: center;
    text-align: center;
  }
  .more-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    color: var(--accent);
  }
  .more-inner p {
    color: var(--text-muted);
    font-size: 14px;
    max-width: 240px;
  }
</style>
