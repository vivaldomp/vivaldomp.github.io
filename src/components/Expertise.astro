---
import Section from './Section.astro';

const areas = [
  {
    icon: 'spec',
    title: 'Spec-Driven Development',
    body: 'Structured engineering workflows that turn specifications into deterministic, auditable build pipelines.',
  },
  {
    icon: 'mcp',
    title: 'MCP & AI Agents',
    body: 'Model Context Protocol ecosystems, sandboxing, and secure execution layers for agent-driven systems.',
  },
  {
    icon: 'graph',
    title: 'Workflow Engines',
    body: 'Rule-based orchestration with graph-driven execution — from declarative DSLs to runtime governance.',
  },
  {
    icon: 'mfe',
    title: 'Microfrontend Platforms',
    body: 'Dynamic composition, governance, and Angular-based DSLs for industrial-scale frontend generation.',
  },
  {
    icon: 'cloud',
    title: 'Cloud-Native Architecture',
    body: 'Production systems on private and public clouds, designed with a strong DevOps mindset end-to-end.',
  },
  {
    icon: 'copilot',
    title: 'AI-Augmented Pipelines',
    body: 'Coding agents (Copilot, Claude) wired into delivery flows — from spec to PR to production.',
  },
];

const icons: Record<string, string> = {
  spec: '<path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6M9 13h6M9 17h6M9 9h2"/>',
  mcp: '<circle cx="12" cy="12" r="3"/><path d="M12 1v6m0 10v6M4.22 4.22l4.24 4.24m7.08 7.08 4.24 4.24M1 12h6m10 0h6M4.22 19.78l4.24-4.24m7.08-7.08 4.24-4.24"/>',
  graph: '<circle cx="6" cy="6" r="2"/><circle cx="18" cy="6" r="2"/><circle cx="12" cy="18" r="2"/><path d="M8 7l3 9M16 7l-3 9"/>',
  mfe: '<rect x="3" y="3" width="7" height="7" rx="1"/><rect x="14" y="3" width="7" height="7" rx="1"/><rect x="3" y="14" width="7" height="7" rx="1"/><rect x="14" y="14" width="7" height="7" rx="1"/>',
  cloud: '<path d="M17.5 19a4.5 4.5 0 1 0-1.4-8.78A6.5 6.5 0 0 0 4 13.5 4.5 4.5 0 0 0 8.5 19h9z"/>',
  copilot: '<path d="M12 2v4M12 18v4M4.93 4.93l2.83 2.83M16.24 16.24l2.83 2.83M2 12h4M18 12h4M4.93 19.07l2.83-2.83M16.24 7.76l2.83-2.83"/><circle cx="12" cy="12" r="4"/>',
};
---

<Section
  id="expertise"
  eyebrow="Expertise"
  title="Where I focus my craft"
  lead="Six areas where I'm building, advising, and shipping today."
>
  <div class="container">
    <ul class="grid">
      {areas.map((a) => (
        <li class="card">
          <div class="icon">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" set:html={icons[a.icon]} />
          </div>
          <h3>{a.title}</h3>
          <p>{a.body}</p>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 16px;
  }
  .card {
    position: relative;
    padding: 28px;
    background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    transition: transform 0.25s ease, border-color 0.25s ease;
    overflow: hidden;
  }
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent-grad);
    opacity: 0;
    transition: opacity 0.25s ease;
    pointer-events: none;
    mix-blend-mode: overlay;
  }
  .card:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
  }
  .card:hover::before {
    opacity: 0.06;
  }
  .icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 44px;
    height: 44px;
    border-radius: 10px;
    background: rgba(34, 211, 238, 0.1);
    color: var(--accent);
    border: 1px solid rgba(34, 211, 238, 0.25);
    margin-bottom: 16px;
  }
  h3 {
    font-size: 18px;
    font-weight: 600;
    margin-bottom: 10px;
  }
  p {
    color: var(--text-muted);
    font-size: 14.5px;
    line-height: 1.65;
  }
</style>
