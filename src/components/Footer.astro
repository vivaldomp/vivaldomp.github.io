---
const year = new Date().getFullYear();
const links = [
  { label: 'GitHub', href: 'https://github.com/vivaldomp', icon: 'gh' },
  { label: 'LinkedIn', href: 'https://www.linkedin.com/in/vivaldomp/', icon: 'li' },
  { label: 'Credly', href: 'https://www.credly.com/users/vivaldo-mendonca-pinto', icon: 'credly' },
];
---

<footer class="footer">
  <div class="container">
    <div class="brand">
      <span class="prompt">$</span>
      <span class="name">vivaldomp</span>
      <span class="cursor"></span>
    </div>

    <nav class="nav" aria-label="Social links">
      {links.map((l) => (
        <a href={l.href} target="_blank" rel="noopener noreferrer" aria-label={l.label}>
          {l.icon === 'gh' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.3v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"/></svg>
          )}
          {l.icon === 'li' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8 17V10H5.5v7H8zM6.75 8.7a1.45 1.45 0 1 0 0-2.9 1.45 1.45 0 0 0 0 2.9zM18 17v-3.85c0-2.06-1.1-3-2.57-3-1.18 0-1.71.65-2 1.1V10h-2.5v7h2.5v-3.92c0-.18.01-.36.07-.49.16-.36.49-.74 1.07-.74.76 0 1.06.57 1.06 1.41V17H18z"/></svg>
          )}
          {l.icon === 'credly' && (
            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 4 6v6c0 5 3.4 9.4 8 10 4.6-.6 8-5 8-10V6l-8-4z"/><path d="m9 12 2 2 4-4"/></svg>
          )}
        </a>
      ))}
    </nav>

    <div class="meta">
      <span>© {year} Vivaldo Mendonca Pinto.</span>
      <span class="sep" aria-hidden="true">·</span>
      <span>Built with <a href="https://astro.build" target="_blank" rel="noopener noreferrer">Astro</a></span>
      <span class="sep" aria-hidden="true">·</span>
      <span>Deployed to GitHub Pages</span>
    </div>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    padding: 56px 0 40px;
    border-top: 1px solid var(--border);
    z-index: 1;
    background: linear-gradient(180deg, transparent, rgba(0, 0, 0, 0.25));
  }
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    text-align: center;
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-family: var(--font-mono);
    font-size: 18px;
    color: var(--text);
  }
  .prompt {
    color: var(--accent);
  }
  .cursor {
    display: inline-block;
    width: 9px;
    height: 18px;
    background: var(--accent);
    animation: blink 1.1s steps(2) infinite;
  }
  @keyframes blink {
    50% { opacity: 0; }
  }
  .nav {
    display: flex;
    gap: 14px;
  }
  .nav a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 40px;
    height: 40px;
    border-radius: 10px;
    background: rgba(255, 255, 255, 0.04);
    border: 1px solid var(--border);
    color: var(--text-muted);
    transition: all 0.2s ease;
  }
  .nav a:hover {
    color: var(--accent);
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .meta {
    font-family: var(--font-mono);
    font-size: 12.5px;
    color: var(--text-dim);
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 8px;
  }
  .meta a {
    color: var(--accent);
  }
  .sep {
    color: var(--border-strong);
  }
</style>
