---
import Section from './Section.astro';

const certs = [
  {
    title: 'CKAD: Certified Kubernetes Application Developer',
    issuer: 'The Linux Foundation',
    issued: 'Sep 2025',
    expires: 'Sep 2027',
    image: 'https://images.credly.com/images/e6066b96-c59d-49b6-87cc-d8873022e84f/blob.png',
    url: 'https://training.linuxfoundation.org/certification/verify/',
  },
  {
    title: 'AWS Certified AI Practitioner',
    issuer: 'Amazon Web Services',
    issued: 'Jul 2025',
    expires: 'Jul 2029',
    image: 'https://images.credly.com/images/4d4693bb-530e-4bca-9327-de07f3aa2348/image.png',
    url: 'https://www.credly.com/users/vivaldo-mendonca-pinto',
  },
  {
    title: 'AWS Certified Developer – Associate',
    issuer: 'Amazon Web Services',
    issued: 'Sep 2024',
    expires: 'Sep 2027',
    image: 'https://images.credly.com/images/b9feab85-1a43-4f6c-99a5-631b88d5461b/image.png',
    url: 'https://www.credly.com/users/vivaldo-mendonca-pinto',
  },
  {
    title: 'AWS Certified Solutions Architect – Associate',
    issuer: 'Amazon Web Services',
    issued: 'Jul 2024',
    expires: 'Jun 2027',
    image: 'https://images.credly.com/images/0e284c3f-5164-4b21-8660-0d84737941bc/image.png',
    url: 'https://www.credly.com/users/vivaldo-mendonca-pinto',
  },
  {
    title: 'AWS Certified Cloud Practitioner',
    issuer: 'Amazon Web Services',
    issued: 'Feb 2023',
    expires: 'Jul 2027',
    image: 'https://images.credly.com/images/00634f82-b07f-4bbd-a6bb-53de397fc3a6/image.png',
    url: 'https://www.credly.com/users/vivaldo-mendonca-pinto',
  },
  {
    title: 'JSNSD: OpenJS Node.js Services Developer',
    issuer: 'OpenJS Foundation',
    issued: 'Oct 2022',
    expires: 'Oct 2025',
    image: 'https://img.shields.io/badge/JSNSD-OpenJS_Foundation-43853d?style=for-the-badge&logo=node.js&logoColor=white',
    url: 'https://openjsf.org/certification',
    isShield: true,
  },
  {
    title: 'JSNAD: OpenJS Node.js Application Developer',
    issuer: 'OpenJS Foundation',
    issued: 'Aug 2022',
    expires: 'Aug 2025',
    image: 'https://img.shields.io/badge/JSNAD-OpenJS_Foundation-43853d?style=for-the-badge&logo=node.js&logoColor=white',
    url: 'https://openjsf.org/certification',
    isShield: true,
  },
  {
    title: 'Oracle Certified Professional, Java EE 5 Web Component Developer',
    issuer: 'Oracle',
    issued: 'Dec 2012',
    expires: 'No expiry',
    image: 'https://img.shields.io/badge/OCP-Java_EE_5_WCD-F80000?style=for-the-badge&logo=oracle&logoColor=white',
    url: 'https://education.oracle.com/credential',
    isShield: true,
  },
];
---

<Section
  id="certifications"
  eyebrow="Credentials"
  title="Certifications"
  lead="Active credentials across cloud, AI, Kubernetes, and Node.js engineering."
>
  <div class="container">
    <ul class="grid">
      {certs.map((c) => (
        <li>
          <a href={c.url} target="_blank" rel="noopener noreferrer" class:list={['cert', { shield: c.isShield }]}>
            <div class="img-wrap">
              <img src={c.image} alt={`${c.title} badge`} loading="lazy" decoding="async" />
            </div>
            <div class="meta">
              <h3>{c.title}</h3>
              <p class="issuer">{c.issuer}</p>
              <p class="dates">
                <span>Issued {c.issued}</span>
                <span class="dot" aria-hidden="true">•</span>
                <span>{c.expires}</span>
              </p>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Section>

<style>
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
  }
  .grid {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 16px;
  }
  .cert {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 14px;
    padding: 24px 18px;
    background: linear-gradient(180deg, var(--surface) 0%, var(--surface-2) 100%);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: var(--text);
    height: 100%;
    transition: transform 0.25s ease, border-color 0.25s ease;
  }
  .cert:hover {
    transform: translateY(-4px);
    border-color: var(--accent);
    color: var(--text);
  }
  .img-wrap {
    width: 110px;
    height: 110px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: rgba(255, 255, 255, 0.02);
    border-radius: 50%;
    padding: 10px;
  }
  .cert.shield .img-wrap {
    width: auto;
    height: auto;
    background: transparent;
    padding: 30px 0;
    border-radius: 0;
  }
  .img-wrap img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.5));
  }
  .cert.shield img {
    height: 32px;
  }
  h3 {
    font-size: 14.5px;
    font-weight: 600;
    line-height: 1.35;
    margin-bottom: 6px;
    min-height: 2.7em;
  }
  .issuer {
    font-size: 13px;
    color: var(--accent);
    margin-bottom: 6px;
  }
  .dates {
    display: flex;
    justify-content: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 11.5px;
    color: var(--text-dim);
    flex-wrap: wrap;
  }
  .dot {
    color: var(--text-dim);
  }
</style>
