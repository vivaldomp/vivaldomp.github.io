---
const stats = [
  { value: '20+', label: 'Years building software' },
  { value: '8', label: 'Active certifications' },
  { value: 'AWS', label: 'Cloud specialty' },
];
---

<header class="hero">
  <div class="container">
    <div class="badge">
      <span class="status"></span>
      <span class="badge-text">Available for advisory & architecture</span>
    </div>

    <h1>
      <span class="hello">Hi, I'm</span>
      <span class="name">Vivaldo Pinto</span>
      <span class="role">
        Platform Engineer <span class="amp">&amp;</span> <span class="grad">Cloud-Native Architect</span>
      </span>
    </h1>

    <p class="tagline">
      Building <strong>AI-augmented</strong> engineering platforms — spec-driven pipelines,
      <strong>microfrontends</strong>, workflow engines, and <strong>MCP</strong> ecosystems
      that industrialize software delivery.
    </p>

    <div class="cta">
      <a class="btn primary" href="#projects">
        <span>Explore my work</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M5 12h14M12 5l7 7-7 7"/>
        </svg>
      </a>
      <a class="btn ghost" href="https://www.linkedin.com/in/vivaldomp/" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14zM8 17V10H5.5v7H8zM6.75 8.7a1.45 1.45 0 1 0 0-2.9 1.45 1.45 0 0 0 0 2.9zM18 17v-3.85c0-2.06-1.1-3-2.57-3-1.18 0-1.71.65-2 1.1V10h-2.5v7h2.5v-3.92c0-.18.01-.36.07-.49.16-.36.49-.74 1.07-.74.76 0 1.06.57 1.06 1.41V17H18z"/></svg>
        LinkedIn
      </a>
      <a class="btn ghost" href="https://github.com/vivaldomp" target="_blank" rel="noopener noreferrer">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 .3a12 12 0 0 0-3.8 23.4c.6.1.8-.3.8-.6v-2c-3.3.7-4-1.6-4-1.6-.6-1.4-1.4-1.8-1.4-1.8-1-.7.1-.7.1-.7 1.2.1 1.8 1.2 1.8 1.2 1 1.8 2.8 1.3 3.5 1 .1-.8.4-1.3.7-1.6-2.7-.3-5.5-1.3-5.5-6 0-1.2.5-2.3 1.3-3.1-.2-.4-.6-1.6 0-3.2 0 0 1-.3 3.4 1.2a11.5 11.5 0 0 1 6 0c2.3-1.5 3.3-1.2 3.3-1.2.7 1.6.2 2.8.1 3.2.8.8 1.3 1.9 1.3 3.1 0 4.6-2.8 5.6-5.5 5.9.5.4.9 1.1.9 2.3v3.3c0 .3.1.7.8.6A12 12 0 0 0 12 .3"/></svg>
        GitHub
      </a>
    </div>

    <div class="stats">
      {stats.map((s) => (
        <div class="stat">
          <div class="stat-value">{s.value}</div>
          <div class="stat-label">{s.label}</div>
        </div>
      ))}
    </div>
  </div>
</header>

<style>
  .hero {
    position: relative;
    padding: 120px 0 80px;
    z-index: 1;
  }
  .container {
    max-width: var(--maxw);
    margin: 0 auto;
    padding: 0 24px;
    text-align: center;
  }
  .badge {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    padding: 6px 14px;
    background: rgba(34, 211, 238, 0.08);
    border: 1px solid rgba(34, 211, 238, 0.25);
    border-radius: 999px;
    font-size: 13px;
    color: var(--text-muted);
    margin-bottom: 28px;
  }
  .badge-text {
    font-family: var(--font-mono);
    letter-spacing: 0.02em;
  }
  .status {
    width: 8px;
    height: 8px;
    background: #22c55e;
    border-radius: 50%;
    box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.7);
    animation: pulse 2s infinite;
  }
  @keyframes pulse {
    0% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0.6); }
    70% { box-shadow: 0 0 0 8px rgba(34, 197, 94, 0); }
    100% { box-shadow: 0 0 0 0 rgba(34, 197, 94, 0); }
  }

  h1 {
    display: flex;
    flex-direction: column;
    gap: 6px;
    margin-bottom: 28px;
  }
  .hello {
    font-family: var(--font-mono);
    font-size: 14px;
    font-weight: 400;
    color: var(--text-muted);
    letter-spacing: 0.06em;
  }
  .name {
    font-size: clamp(44px, 8vw, 88px);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
    background: var(--accent-grad);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    background-size: 200% auto;
    animation: shimmer 8s ease-in-out infinite alternate;
  }
  @keyframes shimmer {
    from { background-position: 0% center; }
    to { background-position: 100% center; }
  }
  .role {
    font-size: clamp(18px, 2.6vw, 26px);
    font-weight: 500;
    color: var(--text);
    margin-top: 6px;
  }
  .amp {
    color: var(--text-dim);
    font-style: italic;
    font-weight: 400;
    margin: 0 4px;
  }
  .grad {
    color: var(--accent);
  }

  .tagline {
    max-width: 680px;
    margin: 0 auto 36px;
    font-size: 18px;
    line-height: 1.7;
    color: var(--text-muted);
  }
  .tagline strong {
    color: var(--text);
    font-weight: 600;
  }

  .cta {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    margin-bottom: 64px;
  }
  .btn {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 12px 20px;
    border-radius: 10px;
    font-size: 15px;
    font-weight: 600;
    border: 1px solid transparent;
    transition: all 0.2s ease;
    cursor: pointer;
    text-decoration: none;
  }
  .btn.primary {
    background: var(--text);
    color: var(--bg);
  }
  .btn.primary:hover {
    transform: translateY(-2px);
    box-shadow: 0 10px 25px -8px rgba(255, 255, 255, 0.25);
    color: var(--bg);
  }
  .btn.ghost {
    background: rgba(255, 255, 255, 0.04);
    border-color: var(--border-strong);
    color: var(--text);
  }
  .btn.ghost:hover {
    background: rgba(255, 255, 255, 0.07);
    border-color: var(--accent);
    color: var(--accent);
    transform: translateY(-2px);
  }

  .stats {
    display: flex;
    gap: 12px;
    justify-content: center;
    flex-wrap: wrap;
    max-width: 720px;
    margin: 0 auto;
  }
  .stat {
    flex: 1 1 180px;
    padding: 22px 18px;
    background: rgba(255, 255, 255, 0.02);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    backdrop-filter: blur(8px);
    transition: border-color 0.25s, transform 0.25s;
  }
  .stat:hover {
    border-color: var(--accent);
    transform: translateY(-2px);
  }
  .stat-value {
    font-family: var(--font-mono);
    font-size: 28px;
    font-weight: 700;
    color: var(--accent);
    line-height: 1;
    margin-bottom: 8px;
  }
  .stat-label {
    font-size: 13px;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  @media (max-width: 640px) {
    .hero { padding: 96px 0 56px; }
    .cta { margin-bottom: 48px; }
  }
</style>
